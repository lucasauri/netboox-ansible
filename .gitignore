# Git ignore file

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Arquivos de credenciais
ansible/ssh_keys/
!ansible/ssh_keys/.gitkeep
*.pem
*.key

# Logs
*.log
logs/
ansible/logs/

# Cache do Ansible
ansible/.ansible/
ansible/roles/**/files/.cache

# Artifacts do Docker
docker-compose.override.yml

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/

# Database files
*.db
*.sqlite
*.sqlite3

# Netbox media files (usually large)
netbox_media/
postgres_data/

# Temporary files
*.tmp
*.temp
*.bak

# Node modules (if using any frontend tools)
node_modules/
npm-debug.log

# Arquivos sensíveis
*credentials*
*secrets*
*password*
