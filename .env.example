# .env - Variáveis de Ambiente para Netbox + Ansible
# Copie este arquivo para .env e atualize os valores conforme necessário

# Netbox
NETBOX_URL=http://netbox:8000
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567
NETBOX_VERIFY_SSL=False

# PostgreSQL
POSTGRES_USER=netbox
POSTGRES_PASSWORD=netbox_password
POSTGRES_DB=netbox
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Ansible
ANSIBLE_INVENTORY=./inventory/hosts
ANSIBLE_HOST_KEY_CHECKING=False

# Docker
COMPOSE_PROJECT_NAME=netbox-ansible
