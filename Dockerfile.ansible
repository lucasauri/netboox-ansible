FROM python:3.11-alpine

WORKDIR /ansible

# Instalar dependências do sistema
RUN apk add --no-cache \
    openssh-client \
    openssh-keyscan \
    git \
    curl \
    sshpass \
    rsync

# Copiar e instalar dependências Python
COPY ansible/requirements.txt ./
RUN pip install --no-cache-dir \
    ansible>=2.13.0 \
    netaddr>=0.10.0 \
    jinja2>=3.1.0 \
    -r requirements.txt

CMD ["tail", "-f", "/dev/null"]
