# Dockerfile para build customizado do Ansible com Netbox
FROM python:3.11-alpine

WORKDIR /ansible

# Instalar dependências do sistema
RUN apk add --no-cache \
    openssh-client \
    openssh-keyscan \
    git \
    curl \
    sshpass \
    rsync

# Instalar Ansible e dependências
RUN pip install --no-cache-dir \
    ansible>=2.13.0 \
    requests>=2.28.0 \
    netaddr>=0.10.0 \
    jinja2>=3.1.0 \
    PyYAML>=6.0 \
    tabulate>=0.9.0

# Copiar requirements.txt se existir
COPY ansible/requirements.txt . 2>/dev/null || true
RUN if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi

# Diretório de trabalho
WORKDIR /ansible

# Comando padrão
CMD ["tail", "-f", "/dev/null"]
