# Dockerfile para build do Ansible com suporte a Netbox
FROM python:3.11-alpine

WORKDIR /ansible

# Instalar dependências do sistema
RUN apk add --no-cache \
    openssh-client \
    openssh-keyscan \
    git \
    curl \
    sshpass \
    rsync

# Instalar Ansible e dependências Python
RUN pip install --no-cache-dir \
    ansible>=2.13.0 \
    requests>=2.28.0 \
    netaddr>=0.10.0 \
    jinja2>=3.1.0 \
    PyYAML>=6.0 \
    tabulate>=0.9.0

# Copiar e instalar requirements do projeto
COPY ansible/requirements.txt /ansible/requirements.txt
RUN pip install --no-cache-dir -r /ansible/requirements.txt

# Comando padrão
CMD ["tail", "-f", "/dev/null"]
